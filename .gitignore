/target

# Docker Hub credentials for pushing secrets to GitHub. Never commit this.
.env

# A node's data directory when running from the repo, and anything `--home` points at.
# It holds an Ed25519 private key.
/.ac
/.ac-server

# The ffmpeg a packaged build ships with. Fetched by scripts/vendor-ffmpeg.sh, pinned there
# by hash, and far too big to keep in the history.
/crates/ac-desktop/vendor/
