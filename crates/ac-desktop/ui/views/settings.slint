import { ScrollView, Button, LineEdit, CheckBox } from "std-widgets.slint";
import { Theme, Card } from "../theme.slint";

component Row inherits VerticalLayout {
    in property <string> label;
    in property <string> hint;
    spacing: Theme.xs;

    Text {
        text: root.label;
        color: Theme.text;
        font-size: Theme.small-size;
        font-weight: 700;
    }

    @children

    if root.hint != "" : Text {
        text: root.hint;
        color: Theme.faint;
        font-size: Theme.small-size;
        wrap: word-wrap;
    }
}

component SectionTitle inherits Text {
    color: Theme.dim;
    font-size: Theme.small-size;
    font-weight: 700;
}

export component SettingsView inherits ScrollView {
    // Loaded once and after each save, never on the poll: refreshing these every two seconds
    // would overwrite whatever is half-typed.
    in property <bool> mdns;
    in property <string> storage-root;
    in property <string> storage-max;
    in property <string> bandwidth-max;
    in property <string> server;

    in property <bool> busy;
    in property <bool> enrolled;

    callback save(bool, string, string, string);
    // Hands back what the field should read, which is what it already read if nothing was
    // chosen.
    callback pick-storage-root(string) -> string;
    callback open-logs();
    callback restart();
    callback join(string, string);

    VerticalLayout {
        spacing: Theme.md;

        SectionTitle { text: "NETWORK"; }

        Card {
            VerticalLayout {
                padding: Theme.md;
                spacing: Theme.md;

                mdns := CheckBox {
                    text: "Find peers on the local network (mDNS)";
                    checked: root.mdns;
                }
            }
        }

        SectionTitle { text: "STORAGE"; }

        Card {
            VerticalLayout {
                padding: Theme.md;
                spacing: Theme.md;

                Row {
                    label: "Keep files in";
                    hint: "Empty means the default inside this node's home.";
                    HorizontalLayout {
                        spacing: Theme.sm;
                        root-dir := LineEdit {
                            text: root.storage-root;
                            horizontal-stretch: 1;
                        }
                        Button {
                            text: "Browse…";
                            enabled: !root.busy;
                            clicked => {
                                root-dir.text = root.pick-storage-root(root-dir.text);
                            }
                        }
                    }
                }

                Row {
                    label: "Storage Limit";
                    hint: "Like 500 GB. Say \"unlimited\" for no ceiling beyond the disk space.";
                    max := LineEdit { text: root.storage-max; }
                }

                Row {
                    label: "Bandwidth limit";
                    hint: "Per second, like 10 MB. Say \"unlimited\" for no limit.";
                    bandwidth := LineEdit { text: root.bandwidth-max; }
                }
            }
        }

        HorizontalLayout {
            spacing: Theme.sm;
            Button {
                text: "Save";
                primary: true;
                enabled: !root.busy;
                clicked => {
                    root.save(mdns.checked, root-dir.text, max.text, bandwidth.text);
                }
            }
            Button {
                text: "Restart the node";
                enabled: !root.busy;
                clicked => { root.restart(); }
            }
            Text {
                // Said before the click, not after: the node reads its config once, at start.
                text: "Saved settings apply when the node next starts.";
                color: Theme.faint;
                font-size: Theme.small-size;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
        }

        SectionTitle { text: "SERVER"; }

        Card {
            VerticalLayout {
                padding: Theme.md;
                spacing: Theme.md;

                if root.enrolled : Row {
                    label: "Enrolled with";
                    hint: "Pinned. A different server at the same address will fail to connect.";
                    Text {
                        text: root.server;
                        color: Theme.dim;
                        font-size: Theme.small-size;
                        font-family: Theme.mono;
                        wrap: char-wrap;
                    }
                }

                if !root.enrolled : Text {
                    // What the daemon warns about a node in this state.
                    text: "This node has not enrolled, so it can verify nobody and can prove "
                        + "nothing about itself. Every peer connection will be closed.";
                    color: Theme.warn;
                    font-size: Theme.small-size;
                    wrap: word-wrap;
                }

                // Only a node that has not enrolled is offered the form: enrolling again is
                // the dialog's job, on the way in.
                if !root.enrolled : Row {
                    label: "Enrol";
                    VerticalLayout {
                        spacing: Theme.sm;
                        token := LineEdit { placeholder-text: "invite token"; }
                        HorizontalLayout {
                            spacing: Theme.sm;
                            who := LineEdit { placeholder-text: "username"; horizontal-stretch: 1; }
                            Button {
                                text: "Enrol";
                                enabled: token.text != "" && who.text != "" && !root.busy;
                                clicked => { root.join(token.text, who.text); }
                            }
                        }
                    }
                }
            }
        }

        SectionTitle { text: "THIS APP"; }

        Card {
            VerticalLayout {
                padding: Theme.md;
                spacing: Theme.sm;

                HorizontalLayout {
                    alignment: start;
                    Button {
                        text: "Open the log folder";
                        clicked => { root.open-logs(); }
                    }
                }
            }
        }

        Rectangle { vertical-stretch: 1; }
    }
}
