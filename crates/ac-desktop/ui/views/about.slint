import { ScrollView } from "std-widgets.slint";
import { Theme, Card, Field } from "../theme.slint";

export component AboutView inherits ScrollView {
    in property <string> version;
    in property <string> peer-id;
    in property <string> home;
    in property <string> storage-root;
    in property <string> log-dir;

    VerticalLayout {
        spacing: Theme.md;

        Card {
            VerticalLayout {
                padding: Theme.md;
                spacing: Theme.sm;

                Text {
                    text: "ArchiverClient";
                    color: Theme.text;
                    font-size: Theme.title-size;
                    font-weight: 700;
                }
                Field { label: "version"; value: root.version; }
                Field { label: "peer id"; value: root.peer-id; monospace: true; elide-start: true; }
                Field { label: "home"; value: root.home; monospace: true; }
                Field { label: "files"; value: root.storage-root; monospace: true; }
                Field { label: "logs"; value: root.log-dir; monospace: true; }
            }
        }

        // The GPL asks that an interactive program carry its notice where a user can find it,
        // and names the about box as the place for a GUI.
        Card {
            VerticalLayout {
                padding: Theme.md;
                spacing: Theme.sm;

                Text {
                    text: "Licence";
                    color: Theme.dim;
                    font-size: Theme.small-size;
                    font-weight: 700;
                }
                Text {
                    text: "ArchiverClient is free software under the GNU General Public "
                        + "License, version 3. It comes with absolutely no warranty. You may "
                        + "redistribute it under the terms in the LICENSE file shipped beside "
                        + "it.";
                    color: Theme.dim;
                    font-size: Theme.small-size;
                    wrap: word-wrap;
                }
                Text {
                    text: "Source: https://github.com/JonathanGriffe/archiverclient";
                    color: Theme.faint;
                    font-size: Theme.small-size;
                    font-family: Theme.mono;
                    wrap: char-wrap;
                }
            }
        }
    }
}
