import { Button, LineEdit, Spinner } from "std-widgets.slint";
import { Theme, Card } from "../theme.slint";

// Shown once, on the way in, to a node that has never enrolled.
//
// Nothing works before this: a node with no attestation can prove nothing about itself and
// every peer connection it makes is closed. Saying so at the door is kinder than letting
// someone create a group and wonder why it never reaches anyone.
//
// It stays up for the whole of enrolling, which stops and restarts the node and can take a
// few seconds. Closing on the click would leave that happening behind an empty window, and
// a refusal from the server would have nowhere to land.
export component EnrolDialog inherits Rectangle {
    // 0 the form, 1 working, 2 done. `settings::ENROL_FORM` and friends.
    in property <int> phase;
    // Why the last attempt failed, shown above the form it goes back to.
    in property <string> error;
    in property <string> summary;
    in property <bool> busy;

    callback enrol(string, string);
    callback dismissed();

    // Held here rather than in the fields, which are torn down and rebuilt with the phase:
    // a refusal over the username should not cost someone the token they pasted.
    property <string> token-text;
    property <string> who-text;

    background: #000000.with-alpha(0.45);

    // Swallows clicks so the page behind cannot be used while this is up.
    TouchArea {}

    Card {
        width: min(480px, parent.width - 2 * Theme.lg);
        height: self.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;

        TouchArea {}

        VerticalLayout {
            padding: Theme.lg;
            spacing: Theme.md;

            Text {
                text: root.phase == 2 ? "Successfully enrolled" : "Enrol this node";
                color: Theme.text;
                font-size: Theme.heading-size;
                font-weight: 700;
            }

            if root.phase == 0 : VerticalLayout {
                spacing: Theme.md;

                if root.error != "" : Rectangle {
                    border-radius: Theme.radius;
                    background: Theme.danger.with-alpha(0.12);

                    VerticalLayout {
                        padding: Theme.sm;
                        Text {
                            text: root.error;
                            color: Theme.danger;
                            font-size: Theme.small-size;
                            wrap: word-wrap;
                        }
                    }
                }

                token := LineEdit {
                    placeholder-text: "invite token";
                    text <=> root.token-text;
                }
                who := LineEdit {
                    placeholder-text: "username";
                    text <=> root.who-text;
                    accepted => {
                        if (root.token-text != "" && root.who-text != "" && !root.busy) {
                            root.enrol(root.token-text, root.who-text);
                        }
                    }
                }
            }

            if root.phase == 1 : HorizontalLayout {
                spacing: Theme.md;

                Spinner {
                    indeterminate: true;
                    width: 24px;
                    height: 24px;
                }
                Text {
                    text: "Enrolling. The node stops and starts again, which takes a moment.";
                    color: Theme.dim;
                    font-size: Theme.small-size;
                    wrap: word-wrap;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }

            if root.phase == 2 : Text {
                text: root.summary;
                color: Theme.dim;
                font-size: Theme.small-size;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: Theme.sm;
                alignment: end;

                if root.phase == 0 : Button {
                    text: "Not now";
                    enabled: !root.busy;
                    clicked => { root.dismissed(); }
                }
                if root.phase == 0 : Button {
                    text: "Enrol";
                    primary: true;
                    enabled: root.token-text != "" && root.who-text != "" && !root.busy;
                    clicked => { root.enrol(root.token-text, root.who-text); }
                }
                if root.phase == 2 : Button {
                    text: "Close";
                    primary: true;
                    clicked => { root.dismissed(); }
                }
            }
        }
    }
}
